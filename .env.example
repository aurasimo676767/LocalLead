NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not needed by the app: RLS is used with the signed-in user's session.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Solo generazione outreach
OPENAI_MESSAGE_MODEL=gpt-5.6-luna
GOOGLE_PLACES_API_KEY=
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# none or screenshotone
SCREENSHOT_PROVIDER=none
SCREENSHOT_API_KEY=
# Open each website in a local headless Chromium (screenshots, ads, phone layout).
# Only where the app runs on your machine: run `pnpm exec playwright install chromium` once.
WEBSITE_BROWSER=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
ANALYSIS_CACHE_HOURS=72
